# Evrima Tracker — server config. Copy to `.env` and fill in.
# Loaded automatically at startup (via dotenv).

# ---- data source ----
# synthetic (default, no server needed) or rcon (connect to a real Evrima server)
DATA_SOURCE=synthetic

# ---- server ----
PORT=4000
POLL_INTERVAL_MS=3000

# ---- live RCON (required when DATA_SOURCE=rcon) ----
RCON_HOST=
RCON_PORT=8888
RCON_PASSWORD=
# Set to 1 to dump the raw getplayerdata response each poll. Use this on the
# first live test to confirm/fix the parser in EvrimaRconDataSource.ts.
RCON_DEBUG=0

# ---- map calibration ----
# World coordinate bounds projected onto the map image. Defaults are placeholders;
# read GET /api/diag (as admin) for the observed coord ranges, then set these.
WORLD_MIN_X=-100000
WORLD_MAX_X=100000
WORLD_MIN_Y=-100000
WORLD_MAX_Y=100000

# ---- auth ----
# Discord OAuth. Setting BOTH enables Discord login and (unless AUTH_DEV=1)
# disables dev login. Create an app at https://discord.com/developers.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: override the OAuth callback URL (needed behind a proxy/custom domain).
# Must match the redirect set in the Discord app: <public-url>/auth/discord/callback
# DISCORD_REDIRECT_URI=

# Comma-separated admin IDs. Use the provider id (Discord user id) or the
# qualified form "discord:123456" / "dev:SomeName".
ADMIN_IDS=

# Force-enable dev login even when Discord is configured (1 = on). Leave unset in
# production: dev login can only grant admin in pure-local dev or to ADMIN_IDS.
AUTH_DEV=
